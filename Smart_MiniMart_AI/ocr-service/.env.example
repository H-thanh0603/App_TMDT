OCR_DEFAULT_ENGINE=mock
LOG_LEVEL=INFO
PORT=5001
# Khóa chia sẻ: đặt giá trị ngẫu nhiên (openssl rand -hex 32) và CÙNG giá trị ở OCR_API_KEY của backend.
# Khi đặt, mọi request /ocr/parse thiếu/sai header X-OCR-Key sẽ bị từ chối (401).
OCR_API_KEY=
# Giới hạn an toàn
OCR_MAX_IMAGE_BYTES=10485760
OCR_MAX_IMAGE_PIXELS=40000000
OCR_FETCH_TIMEOUT_S=15
