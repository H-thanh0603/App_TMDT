// ============================================================================
// Smart MiniMart AI - Prisma Schema
// PostgreSQL 16 + Prisma 5
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  CUSTOMER
  STAFF
  STORE_ADMIN
  AI_MANAGER
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  DELIVERING
  COMPLETED
  CANCELED
}

enum PaymentMethod {
  COD
  QR_DEMO
  WALLET_DEMO
  VNPAY_SANDBOX
  BANK
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

enum InventoryTxnType {
  IMPORT
  EXPORT
  ADJUST
  SALE
  RETURN
  EXPIRE
}

enum ImportReceiptStatus {
  DRAFT
  OCR_PROCESSING
  OCR_DONE
  REVIEWED
  CONFIRMED
  REJECTED
}

enum AIProviderType {
  SYSTEM_DEFAULT
  DEEPSEEK
  OPENAI_COMPATIBLE
  ANTHROPIC
  GEMINI
  CUSTOM
  MOCK
}

enum AIProviderStatus {
  ACTIVE
  DISABLED
  ERROR
}

enum AITaskType {
  AI_SEARCH
  AI_ASSISTANT
  OCR_PARSE
  ANALYTICS_SLOWMOVING
  PROMOTION_SUGGEST
  REVIEW_SUMMARY
  CONTENT_GENERATION
  RESTOCK_SUGGEST
}

enum AIMode {
  ONLINE
  RULE_BASED
  MOCK
  HYBRID
}

enum OCREngine {
  MOCK
  PADDLE_OCR
  EASY_OCR
  TESSERACT
  GOOGLE_VISION
  LLM_VISION
  HYBRID
}

enum PromotionType {
  PERCENT
  AMOUNT
  COMBO
  FLASH_SALE
  EXPIRY_DISCOUNT
}

// ============================================================================
// USERS & AUTH
// ============================================================================

model User {
  id             String     @id @default(uuid())
  email          String     @unique
  phone          String?    @unique
  passwordHash   String
  fullName       String
  avatarUrl      String?
  role           Role       @default(CUSTOMER)
  status         UserStatus @default(ACTIVE)
  loyaltyPoints  Int        @default(0)
  isVip          Boolean    @default(false)
  lastLoginAt    DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  addresses      Address[]
  orders         Order[]
  paymentConfirmations PaymentConfirmation[]
  reviews        Review[]
  cart           Cart?
  refreshTokens  RefreshToken[]
  inventoryTxns  InventoryTransaction[] @relation("InventoryCreatedBy")
  importReceipts ImportReceipt[]        @relation("ImportReceiptCreatedBy")
  aiLogs         AILog[]                @relation("AILogUser")
  notifications  Notification[]

  @@index([role, status])
  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  userAgent String?
  ip        String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Address {
  id           String   @id @default(uuid())
  userId       String
  recipient    String
  phone        String
  line1        String
  ward         String?
  district     String?
  city         String?
  isDefault    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  orders Order[]

  @@index([userId])
  @@map("addresses")
}

// ============================================================================
// CATALOG - Categories & Products
// ============================================================================

model Category {
  id          String   @id @default(uuid())
  name        String   @unique
  slug        String   @unique
  description String?
  imageUrl    String?
  parentId    String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id              String   @id @default(uuid())
  sku             String   @unique
  barcode         String?  @unique
  name            String
  slug            String   @unique
  description     String?
  shortDescription String?
  categoryId      String
  brand           String?
  unit            String   @default("cái") // cái, lốc, chai, gói, kg, lít...
  importPrice     Decimal  @default(0) @db.Decimal(12, 2)
  price           Decimal  @db.Decimal(12, 2)
  salePrice       Decimal? @db.Decimal(12, 2)
  stock           Int      @default(0)
  reservedStock   Int      @default(0) // số đã đặt nhưng chưa giao
  minStock        Int      @default(5)
  maxStock        Int      @default(100)
  expiryDate      DateTime? // hạn sử dụng lô hàng hiện tại (đơn giản hóa)
  imageUrl        String?
  tags            String[] @default([])
  attributes      Json?    // {"calories": 100, "lowSugar": true, ...}
  isActive        Boolean  @default(true)
  isFeatured      Boolean  @default(false)
  soldCount       Int      @default(0)
  viewCount       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category           Category               @relation(fields: [categoryId], references: [id])
  images             ProductImage[]
  cartItems          CartItem[]
  orderItems         OrderItem[]
  inventoryTxns      InventoryTransaction[]
  reviews            Review[]
  importReceiptItems ImportReceiptItem[]
  promotionProducts  PromotionProduct[]

  @@index([categoryId, isActive])
  @@index([expiryDate])
  @@index([isFeatured])
  @@map("products")
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  url       String
  sortOrder Int      @default(0)
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

// ============================================================================
// CART & ORDERS
// ============================================================================

model Cart {
  id        String   @id @default(uuid())
  userId    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id        String   @id @default(uuid())
  cartId    String
  productId String
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cart    Cart    @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@unique([cartId, productId])
  @@map("cart_items")
}

model Order {
  id              String        @id @default(uuid())
  orderNumber     String        @unique // SMM-2026-000001
  userId          String
  addressId       String?
  status          OrderStatus   @default(PENDING)
  paymentMethod   PaymentMethod @default(COD)
  paymentStatus   PaymentStatus @default(UNPAID)
  subtotal        Decimal       @db.Decimal(12, 2)
  discountAmount  Decimal       @default(0) @db.Decimal(12, 2)
  shippingFee     Decimal       @default(0) @db.Decimal(12, 2)
  totalAmount     Decimal       @db.Decimal(12, 2)
  promotionCode   String?
  paymentRef      String?       // VNPay txnRef hoặc external payment reference
  note            String?
  loyaltyEarned   Int           @default(0)
  cancelReason    String?
  confirmedAt     DateTime?
  deliveredAt     DateTime?
  completedAt     DateTime?
  canceledAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user    User        @relation(fields: [userId], references: [id])
  address Address?    @relation(fields: [addressId], references: [id])
  items   OrderItem[]
  paymentConfirmation PaymentConfirmation?

  @@index([userId, status])
  @@index([status, createdAt])
  @@map("orders")
}

model PaymentConfirmation {
  id                 String   @id @default(uuid())
  orderId            String   @unique
  bankTransactionRef String
  note               String?
  confirmedById      String
  confirmedAt        DateTime @default(now())

  order       Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  confirmedBy User  @relation(fields: [confirmedById], references: [id])

  @@index([confirmedById])
  @@map("payment_confirmations")
}

model OrderItem {
  id          String  @id @default(uuid())
  orderId     String
  productId   String
  productName String  // snapshot tên SP tại thời điểm mua
  unitPrice   Decimal @db.Decimal(12, 2)
  quantity    Int
  subtotal    Decimal @db.Decimal(12, 2)

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

// ============================================================================
// INVENTORY & IMPORT RECEIPTS (OCR)
// ============================================================================

model InventoryTransaction {
  id        String           @id @default(uuid())
  productId String
  type      InventoryTxnType
  quantity  Int              // dương = nhập, âm = xuất
  reason    String?
  refType   String?          // "ORDER" | "IMPORT_RECEIPT" | "MANUAL"
  refId     String?
  beforeQty Int
  afterQty  Int
  createdById String?
  createdAt DateTime         @default(now())

  product   Product @relation(fields: [productId], references: [id])
  createdBy User?   @relation("InventoryCreatedBy", fields: [createdById], references: [id])

  @@index([productId, createdAt])
  @@index([type, createdAt])
  @@map("inventory_transactions")
}

model ImportReceipt {
  id              String              @id @default(uuid())
  receiptNumber   String              @unique // IR-2026-000001
  supplierName    String
  supplierPhone   String?
  importDate      DateTime
  imageUrl        String?             // ảnh phiếu nhập gốc
  status          ImportReceiptStatus @default(DRAFT)
  ocrEngine       OCREngine?          // engine đã dùng để parse
  ocrRawText      String?             // raw text từ OCR
  ocrParsedJson   Json?               // JSON parsed (do AI Parser xử lý)
  ocrConfidence   Float?              // 0..1
  totalAmount     Decimal             @default(0) @db.Decimal(14, 2)
  notes           String?
  createdById     String
  reviewedById    String?
  confirmedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  createdBy User                @relation("ImportReceiptCreatedBy", fields: [createdById], references: [id])
  items     ImportReceiptItem[]

  @@index([status, createdAt])
  @@map("import_receipts")
}

model ImportReceiptItem {
  id              String   @id @default(uuid())
  importReceiptId String
  productId       String?  // có thể null nếu chưa map vào sản phẩm
  rawProductName  String   // tên thô từ OCR
  productName     String   // tên đã chuẩn hóa
  quantity        Int
  unit            String   @default("cái")
  unitPrice       Decimal  @db.Decimal(12, 2)
  expiryDate      DateTime?
  confidence      Float    @default(1.0) // độ tin cậy của dòng này
  isVerified      Boolean  @default(false)
  notes           String?

  importReceipt ImportReceipt @relation(fields: [importReceiptId], references: [id], onDelete: Cascade)
  product       Product?      @relation(fields: [productId], references: [id])

  @@index([importReceiptId])
  @@map("import_receipt_items")
}

// ============================================================================
// PROMOTIONS & REVIEWS
// ============================================================================

model Promotion {
  id             String        @id @default(uuid())
  code           String        @unique
  name           String
  description    String?
  type           PromotionType
  discountValue  Decimal       @db.Decimal(12, 2) // % hoặc số tiền
  minOrderValue  Decimal?      @db.Decimal(12, 2)
  maxDiscount    Decimal?      @db.Decimal(12, 2)
  usageLimit     Int?
  usageCount     Int           @default(0)
  startDate      DateTime
  endDate        DateTime
  isActive       Boolean       @default(true)
  isAutoApply    Boolean       @default(false) // VD: hàng gần hết hạn -> tự áp
  conditions     Json?         // điều kiện nâng cao
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  products PromotionProduct[]

  @@index([isActive, startDate, endDate])
  @@map("promotions")
}

model PromotionProduct {
  promotionId String
  productId   String

  promotion Promotion @relation(fields: [promotionId], references: [id], onDelete: Cascade)
  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([promotionId, productId])
  @@map("promotion_products")
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  productId String
  orderId   String?
  rating    Int      // 1..5
  comment   String?
  imageUrls String[] @default([])
  aiSummary String?  // tóm tắt do AI sinh
  isHidden  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId, orderId])
  @@index([productId])
  @@map("reviews")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  title     String
  body      String
  type      String   // ORDER | PROMOTION | EXPIRY | SYSTEM
  data      Json?
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

// ============================================================================
// AI MANAGER - Providers, Task Configs, OCR Settings, Logs
// ============================================================================

model AIProvider {
  id              String           @id @default(uuid())
  name            String           @unique
  type            AIProviderType
  baseUrl         String?
  apiKeyEncrypted String?          // mã hóa AES-256-GCM
  apiKeyMasked    String?          // hiển thị: sk-***1234
  defaultModel    String?
  status          AIProviderStatus @default(ACTIVE)
  isSystemDefault Boolean          @default(false)
  config          Json?            // tham số mở rộng (timeout, headers...)
  lastTestedAt    DateTime?
  lastTestResult  Json?            // {success: bool, latencyMs, error}
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  primaryConfigs  AITaskConfig[] @relation("PrimaryProvider")
  fallbackConfigs AITaskConfig[] @relation("FallbackProvider")

  @@map("ai_providers")
}

model AITaskConfig {
  id                  String     @id @default(uuid())
  taskType            AITaskType @unique
  primaryProviderId   String?
  primaryModel        String?
  fallbackProviderId  String?
  fallbackModel       String?
  mode                AIMode     @default(HYBRID)
  systemPrompt        String?
  userPromptTemplate  String?
  temperature         Float      @default(0.7)
  maxTokens           Int        @default(1024)
  timeoutMs           Int        @default(30000)
  isEnabled           Boolean    @default(true)
  config              Json?
  updatedAt           DateTime   @updatedAt

  primaryProvider  AIProvider? @relation("PrimaryProvider", fields: [primaryProviderId], references: [id])
  fallbackProvider AIProvider? @relation("FallbackProvider", fields: [fallbackProviderId], references: [id])

  @@map("ai_task_configs")
}

model OCRSettings {
  id                  String    @id @default(uuid())
  isSingleton         Boolean   @default(true) @unique // chỉ 1 row
  defaultEngine       OCREngine @default(MOCK)
  fallbackEngine      OCREngine @default(MOCK)
  confidenceThreshold Float     @default(0.6)
  requireReview       Boolean   @default(true)
  llmParserEnabled    Boolean   @default(true)
  llmParserTaskType   AITaskType? // mặc định OCR_PARSE
  config              Json?
  updatedAt           DateTime  @updatedAt

  @@map("ocr_settings")
}

// ============================================================================
// AI LOGS, PROMPTS, USAGE LIMITS
// ============================================================================

model AIPromptTemplate {
  id          String     @id @default(uuid())
  taskType    AITaskType
  name        String
  description String?
  systemPrompt String
  userTemplate String
  variables   Json?      // ["query", "products", ...]
  isDefault   Boolean    @default(false)
  isActive    Boolean    @default(true)
  version     Int        @default(1)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([taskType, name])
  @@map("ai_prompt_templates")
}

model AILog {
  id           String     @id @default(uuid())
  taskType     AITaskType
  providerId   String?
  providerName String?
  model        String?
  mode         AIMode
  status       String     // success | error | fallback | timeout
  inputSummary String?    // tóm tắt input (cắt 500 ký tự)
  outputSummary String?   // tóm tắt output
  errorMessage String?
  latencyMs    Int?
  promptTokens Int?
  completionTokens Int?
  totalTokens  Int?
  costUsd      Decimal?   @db.Decimal(10, 6)
  confidence   Float?
  userId       String?
  refType      String?    // ORDER | IMPORT_RECEIPT | SEARCH | ...
  refId        String?
  metadata     Json?
  createdAt    DateTime   @default(now())

  user User? @relation("AILogUser", fields: [userId], references: [id])

  @@index([taskType, createdAt])
  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@map("ai_logs")
}

model AIUsageLimit {
  id              String     @id @default(uuid())
  scope           String     @unique // "global" | "task:OCR_PARSE" | "user:<id>"
  dailyRequestLimit Int?
  monthlyRequestLimit Int?
  dailyCostLimitUsd  Decimal? @db.Decimal(10, 4)
  monthlyCostLimitUsd Decimal? @db.Decimal(10, 4)
  currentDayCount    Int       @default(0)
  currentMonthCount  Int       @default(0)
  currentDayCost     Decimal   @default(0) @db.Decimal(10, 6)
  currentMonthCost   Decimal   @default(0) @db.Decimal(10, 6)
  resetDayAt         DateTime?
  resetMonthAt       DateTime?
  isEnforced         Boolean   @default(true)
  updatedAt          DateTime  @updatedAt

  @@map("ai_usage_limits")
}

model SystemSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("system_settings")
}
