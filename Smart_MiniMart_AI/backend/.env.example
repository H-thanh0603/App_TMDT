# === Server ===
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
# Danh sách origin được phép, cách nhau bằng dấu phẩy.
# Production bắt buộc đặt domain thật, ví dụ: CORS_ORIGIN=https://app.minimart.vn
CORS_ORIGIN=*
# Trust proxy (SEC-031): 'false' (dev) | 'true'/1 (1 hop, mặc định production) | số hop.
TRUST_PROXY=

# === Database ===
# Prod (Neon): thêm ?connection_limit=5&pool_timeout=10&connect_timeout=10 (Q77).
DATABASE_URL="postgresql://minimart:minimart_dev_2026@localhost:5432/smart_minimart?schema=public"

# === Auth (JWT) ===
JWT_ACCESS_SECRET=replace-with-openssl-rand-hex-32
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace-with-openssl-rand-hex-32
JWT_REFRESH_EXPIRES=14d

# Mật khẩu dùng khi seed tài khoản mẫu (>= 8 ký tự). BẮT BUỘC trên production.
SEED_DEFAULT_PASSWORD=

# === Observability (Q139: Sentry — để trống = tắt, điền DSN khi vận hành) ===
SENTRY_DSN=

# === AI Gateway ===
# Provider mặc định: deepseek | openai | anthropic | gemini | mock
AI_DEFAULT_PROVIDER=deepseek
AI_DEFAULT_MODEL=deepseek-chat
AI_FALLBACK_PROVIDER=mock

# DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI compatible (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude (optional)
ANTHROPIC_API_KEY=

# Google Gemini (optional)
GEMINI_API_KEY=

# Encryption key (32-byte hex) - dùng để mã hóa API key trong DB
# BẮT BUỘC cấu hình giá trị ngẫu nhiên riêng: openssl rand -hex 32
AI_ENCRYPTION_KEY=

# === OCR Service ===
OCR_SERVICE_URL=http://localhost:5001
# Khóa chia sẻ với OCR service (openssl rand -hex 32). Đặt CÙNG giá trị ở OCR_API_KEY của ocr-service.
OCR_API_KEY=
OCR_DEFAULT_ENGINE=mock
OCR_CONFIDENCE_THRESHOLD=0.6

# === Storage ===
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# === Throttling ===
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# === VNPay (điền khi thu tiền — sandbox hay prod theo quyết định vận hành) ===
# --- Payments ---
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
# Sandbox: https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
# Prod:    https://www.vnpayment.vn/paymentv2/vpcpay.html  <-- đổi khi thu tiền thật (Q155)
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=https://smart-minimart-api.onrender.com/api/v1/payments/vnpay/return

# VietQR tĩnh (điền STK thật của shop khi deploy — KHÔNG commit STK thật vào repo)
VIETQR_BANK_BIN=
VIETQR_ACCOUNT_NO=
VIETQR_ACCOUNT_NAME=
VIETQR_TEMPLATE=compact
