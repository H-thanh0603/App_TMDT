# === Server ===
NODE_ENV=development
PORT=4000
API_PREFIX=api/v1
CORS_ORIGIN=*

# === Database ===
DATABASE_URL="postgresql://minimart:minimart_dev_2026@localhost:5432/smart_minimart?schema=public"

# === Auth (JWT) ===
JWT_ACCESS_SECRET=replace-with-openssl-rand-hex-32
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=replace-with-openssl-rand-hex-32
JWT_REFRESH_EXPIRES=14d

# === AI Gateway ===
# Provider mặc định: deepseek | openai | anthropic | gemini | mock
AI_DEFAULT_PROVIDER=deepseek
AI_DEFAULT_MODEL=deepseek-chat
AI_FALLBACK_PROVIDER=mock

# DeepSeek (https://platform.deepseek.com)
DEEPSEEK_API_KEY=sk-your-deepseek-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# OpenAI compatible (optional)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic Claude (optional)
ANTHROPIC_API_KEY=

# Google Gemini (optional)
GEMINI_API_KEY=

# Encryption key (32-byte hex) - dùng để mã hóa API key trong DB
AI_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# === OCR Service ===
OCR_SERVICE_URL=http://localhost:5001
OCR_DEFAULT_ENGINE=mock
OCR_CONFIDENCE_THRESHOLD=0.6

# === Storage ===
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# === Throttling ===
THROTTLE_TTL=60
THROTTLE_LIMIT=100

# === VNPay Sandbox (optional) ===
# Đăng ký sandbox tại https://sandbox.vnpayment.vn/
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:4000/api/v1/payments/vnpay/return
